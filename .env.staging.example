# Flint Apply staging frontend / compose OAuth — copy to .env.staging (gitignored via *.env)
# Local simulation: ports 3001/8001. Production (flintapply.com): use 3000/8000 behind Caddy — see STAGING.md §8.
STAGING_FRONTEND_PORT=3001
STAGING_BACKEND_PORT=8001
POSTGRES_PASSWORD=password

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Production VM pre-launch (optional locally — leave empty to disable gate)
# NEXT_PUBLIC_LAUNCH_AT=2026-10-01T09:00:00-07:00
# LAUNCH_AT=2026-10-01T09:00:00-07:00
# LAUNCH_PREVIEW_SECRET=generate-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
